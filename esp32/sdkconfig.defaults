CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Sub-20 ms audio deadlines need finer socket timeout/task wait granularity.
CONFIG_FREERTOS_HZ=1000

# A larger app image preserves the existing NVS and PHY partition addresses.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Waveshare ESP32-S3R8: 8 MiB Octal PSRAM. Prefer large peer buffers in PSRAM,
# retaining internal memory for task stacks, DMA, Wi-Fi and DTLS allocations.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 80 MHz PSRAM and quad flash: echo cancellation (tx_voice.c) and Opus ran
# about twice as fast as with 40 MHz and dual flash, and only then kept up.
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# DTLS handshakes and echo cancellation are computation-heavy: the board's
# supported 240 MHz CPU setting.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y

# SD card ringtones are named ringtone-NN.mp3: longer than FAT's 8.3 names.
CONFIG_FATFS_LFN_HEAP=y
# SD card and answering-machine tasks keep their stacks in PSRAM, leaving
# internal RAM for the call audio workers.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# The Wi-Fi setup page (HTTP server and DNS) needs sockets besides signaling and calls.
CONFIG_LWIP_MAX_SOCKETS=16
# Two firmware slots (partitions.csv): roll back an update that fails before
# marking itself valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# DTLS (mbedTLS) buffers in PSRAM: doubles the internal RAM left during calls
# (measured 27-29 KB -> 54 KB free) without audio cost. Wi-Fi/lwIP buffers
# stay internal: in PSRAM they made outgoing audio skip 2-5% of frames.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
